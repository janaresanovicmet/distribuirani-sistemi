def lowercase_wrapper(func):
    def wrapper():
        text = input("Unesite tekst: ")
        text = text.lower()

        with open("text.txt", "w", encoding="utf-8") as file:
            file.write(text)

        print("Tekst je upisan malim slovima u datoteku text.txt")

    return wrapper


@lowercase_wrapper
def write_text_to_file():
    text = input("Unesite tekst: ")

    with open("text.txt", "w", encoding="utf-8") as file:
        file.write(text)

    print("Tekst je upisan u datoteku text.txt")


write_text_to_file()
